{
  // Type checking only; see CODING_STANDARDS.md and the shared preset.
  "extends": "@jeroenwijnen98/standards/tsconfig/node.json",
  "compilerOptions": {
    // Lets the .ts files import the modules still in .js, with inferred
    // types; those files are not checked themselves (no checkJs).
    "allowJs": true
  },
  "include": ["server.ts", "src", "scripts", "test"]
}
