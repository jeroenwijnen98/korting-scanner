{
  "name": "korting-scanner",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node server.ts",
    "sandcastle": "tsx .sandcastle/main.mts",
    "typecheck": "tsc -p . && tsc -p public",
    "lint": "oxlint --deny-warnings",
    "test": "npm run typecheck && npm run lint && node --test \"test/**/*.test.ts\"",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@jeroenwijnen98/standards": "github:jeroenwijnen98/standards#v0.1.0",
    "@oxlint/plugins": "1.86.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "oxlint": "1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
